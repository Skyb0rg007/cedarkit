// Core CedarKit entity model. Action declarations live alongside the policies
// that use them (e.g. `systemd/*.cedarschema`).
//
// Policies must validate against the schema, and requests are checked
// against it. Actions that aren't declared are denied.

entity Group;

// As a resource (e.g. the user whose lingering is changed), identified by
// the `uid` detail. Its name, attributes and groups are looked up from the
// account database, as for principals.
@detail("uid")
entity User in [Group] {
  @detail("uid")
  name: String,
  @detail("uid")
  uid: Long,
};

// The machine itself.
entity System;

// How the subject has authenticated for this request, as `context.auth`.
// polkit's auth_self and auth_admin results are conditions on it:
//
//   auth_self_keep   ["self", "admin"].contains(context.auth.identity)
//   auth_self        ... && context.auth.fresh
//   auth_admin_keep  context.auth.identity == "admin"
//   auth_admin       ... && context.auth.fresh
//
// It's an entity, rather than a record in the context, so that CedarKit can
// leave its attributes unknown to find out whether authenticating would help.
entity Authentication {
  // "none", "self" or "admin".
  identity: String,
  // Just entered, rather than remembered from an earlier authentication.
  fresh: Bool,
};

type SessionContext = {
  local: Bool,
  active: Bool,
  auth: Authentication,
};
